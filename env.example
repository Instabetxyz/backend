# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/streambet

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Blockchain (0G Testnet) ───────────────────────────────
RPC_URL=https://rpc-testnet.0g.ai
CHAIN_ID=16600
DEPLOYER_PRIVATE_KEY=0x...

# Contract addresses (populated after deploy)
PREDICTION_MARKET=0x...
AGENT_REGISTRY_ADDRESS=0x...

# ── Trio / MachineFi ──────────────────────────────────────
TRIO_API_KEY=your_trio_api_key
TRIO_BASE_URL=https://trio.machinefi.com/api
TRIO_WEBHOOK_SECRET=your_trio_webhook_hmac_secret

# Public URL this server is reachable at (for Trio webhooks)
PUBLIC_BASE_URL=https://api.streambet.xyz/v1

# ── Chainlink CRE ─────────────────────────────────────────
CRE_WORKFLOW_ENDPOINT=https://your-cre-workflow-endpoint
CRE_API_KEY=your_cre_api_key

# ── 0G Network ────────────────────────────────────────────
OG_STORAGE_RPC=https://rpc-storage-testnet.0g.ai
OG_COMPUTE_ENDPOINT=https://compute-testnet.0g.ai
